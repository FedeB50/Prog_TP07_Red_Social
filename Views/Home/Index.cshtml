@{
    ViewData["Title"] = "Home Page";
}

@foreach (Publicaciones publicacion in ViewBag.publicaciones)
{
    <div class="publicacion">
        <h2>@publicacion.titulo</h2>
        <p>@publicacion.descripcion</p>
        <img src="~/images/@publicacion.imagen" alt="Descripción de la imagen">
        <p>Publicado por: @ViewBag.arroba@publicacion.username</p>
        <p>Fecha de publicación: @publicacion.fechaPublicacion.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
}
